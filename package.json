{
  "name": "focusdesk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && electron-builder --win nsis --x64 --publish never",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:app": "tsc && vite build"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2"
  },
  "main": "dist-electron/main.js",
  "description": "Aplicación de escritorio para organizar tareas y sesiones de estudio con Pomodoro.",
  "author": "dcarpin03",
  "engines": {
    "node": ">=22.12.0"
  }
}
